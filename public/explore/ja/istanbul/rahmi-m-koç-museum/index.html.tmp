<style>
:root{--bg:#110c08;--fg:#f9f4ec;--muted:#a99c8e;--border:#352c25;--gold:#f5b75b;--card:#1b1510;--body:#e7ddcf;--green:#5dcaa5;--blue:#85b7eb}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--fg);font-family:'Inter',ui-sans-serif,system-ui,sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased}
.page{max-width:620px;margin:0 auto;padding:0 20px 120px}
a{color:var(--gold)}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 0 12px}
.brand{font-family:'Playfair Display',ui-serif,Georgia,serif;font-size:21px;font-weight:600;color:var(--fg);text-decoration:none}
.lang-dd{position:relative}
.lang-dd summary{list-style:none;cursor:pointer;font-size:12px;font-weight:600;color:var(--muted);padding:6px 13px;border-radius:999px;border:1px solid var(--border);display:inline-flex;align-items:center;gap:6px}
.lang-dd summary::-webkit-details-marker{display:none}
.lang-dd summary::after{content:"\25BE";font-size:9px;opacity:.8}
.lang-dd[open] summary{color:var(--fg);border-color:var(--gold)}
.lang-menu{position:absolute;right:0;top:calc(100% + 6px);min-width:170px;max-height:300px;overflow-y:auto;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:6px;z-index:60;box-shadow:0 14px 34px rgba(0,0,0,.55)}
.lang-menu a{display:block;padding:9px 12px;border-radius:8px;font-size:13px;color:var(--body);text-decoration:none}
.lang-menu a.active{color:var(--gold);font-weight:600}
nav.crumbs{font-size:12.5px;color:var(--muted);margin:2px 0 14px;line-height:1.9}
nav.crumbs a{color:var(--muted);text-decoration:none;border-bottom:1px solid transparent}
nav.crumbs a:hover{color:var(--gold);border-bottom-color:var(--gold)}
nav.crumbs .sep{opacity:.5;margin:0 5px}
.hero-img{position:relative;border-radius:20px;overflow:hidden;aspect-ratio:5/4;background:var(--card)}
.hero-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.hero-img .ov{position:absolute;inset:0;background:linear-gradient(180deg,rgba(17,12,8,0) 0%,rgba(17,12,8,.35) 55%,rgba(17,12,8,.92) 100%)}
.badge{position:absolute;left:14px;bottom:14px;display:inline-flex;align-items:center;gap:6px;background:rgba(17,12,8,.55);border:1px solid rgba(245,183,91,.4);color:var(--gold);text-transform:uppercase;letter-spacing:1.6px;font-size:10px;font-weight:700;padding:6px 11px;border-radius:999px;backdrop-filter:blur(6px)}
h1{font-family:'Playfair Display',ui-serif,Georgia,serif;font-weight:500;font-size:36px;line-height:1.08;margin-top:16px}
.geoline{font-size:11.5px;color:var(--muted);letter-spacing:.4px;margin-top:8px}
.answer{margin-top:14px;padding:15px 17px;background:rgba(245,183,91,.06);border:1px solid rgba(245,183,91,.28);border-left:3px solid var(--gold);border-radius:12px;font-size:15.5px;color:var(--fg);line-height:1.7}
.verified{display:inline-flex;align-items:center;gap:6px;margin-top:12px;font-size:11.5px;color:var(--muted)}
.verified b{color:var(--green);font-weight:600}
.verified a{color:var(--muted);text-decoration:underline;text-underline-offset:2px}
.cta-row{display:flex;gap:10px;margin-top:16px}
.cta{flex:1;display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(135deg,#fdc357,#f67f2f);color:#110c08;border-radius:16px;padding:12px 18px;text-decoration:none;box-shadow:0 0 60px -16px #f5b75b8c}
.cta .play{display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:rgba(17,12,8,.15);color:#110c08}
.cta .lbl{display:flex;flex-direction:column;line-height:1.1}
.cta .lbl small{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;opacity:.75}
.cta .lbl b{font-size:16px;font-weight:700}
.sec{font-family:'Playfair Display',ui-serif,Georgia,serif;font-weight:500;font-size:22px;color:var(--fg);margin:34px 0 12px}
table.facts-tbl{width:100%;border-collapse:collapse;margin-top:6px;font-size:14px}
table.facts-tbl th,table.facts-tbl td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:top}
table.facts-tbl th{color:var(--muted);font-weight:600;width:42%;white-space:nowrap}
table.facts-tbl td{color:var(--body)}
table.facts-tbl tr:last-child th,table.facts-tbl tr:last-child td{border-bottom:none}
.tour p{font-size:15.5px;color:var(--body);line-height:1.85;margin:0 0 15px}
.chips .item{display:flex;align-items:flex-start;gap:9px;border-radius:14px;padding:10px 14px;font-size:13.5px;line-height:1.45;margin:0 0 9px;width:fit-content;max-width:100%}
.chips .item svg{flex-shrink:0;margin-top:2px}
.facts .item{background:rgba(29,158,117,.09);border:1px solid rgba(93,202,165,.3);color:#a7e6d1}
.facts .item svg{color:var(--green)}
.look .item{background:rgba(55,138,221,.09);border:1px solid rgba(133,183,235,.3);color:#bcd8f4}
.look .item svg{color:var(--blue)}
.tips .item{background:rgba(250,188,5,.08);border:1px solid rgba(250,188,5,.3);color:#ffc955}
.tips .item svg{color:#f5b75b}
.faq h3{font-size:15px;font-weight:600;color:var(--fg);margin:18px 0 7px;line-height:1.4}
.faq h3:first-child{margin-top:4px}
.faq p{font-size:14.5px;color:var(--body);line-height:1.75;margin:0}
.nearby{display:grid;gap:8px;margin-top:6px}
.nearby a{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:11px 14px;text-decoration:none;color:var(--body);font-size:14px}
.nearby a:hover{border-color:var(--gold);color:var(--gold)}
.nearby .km{margin-left:auto;color:var(--muted);font-size:12px;white-space:nowrap}
.mapcard a{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:14px 16px;text-decoration:none;color:var(--fg);font-weight:600;font-size:14.5px}
.mapcard a:hover{border-color:var(--gold)}
.mapcard .ic{color:var(--gold);display:flex}
.mapcard .arr{margin-left:auto;color:var(--muted)}
.map-note{font-size:12.5px;color:var(--muted);margin-top:8px}
.srcbox{margin-top:8px;font-size:13px;color:var(--muted);line-height:1.8}
.srcbox a{color:var(--gold);text-decoration:none;border-bottom:1px solid rgba(245,183,91,.35)}
footer{border-top:1px solid var(--border);margin-top:40px;padding-top:20px;color:var(--muted);font-size:12.5px;line-height:1.9}
footer a{color:var(--gold);text-decoration:none}
.appbar-cta{position:fixed;bottom:20px;left:20px;right:20px;display:none;z-index:50}
.appbar-cta.show{display:block}
.appbar-cta .pill{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--border);border-radius:16px;padding:10px 12px;box-shadow:0 8px 20px rgba(0,0,0,.4);max-width:600px;margin:0 auto}
.appbar-cta a{display:flex;align-items:center;gap:8px;flex:1;text-decoration:none;color:var(--fg)}
.appbar-cta svg{width:32px;height:32px;flex-shrink:0}
.appbar-cta .lb{display:flex;flex-direction:column;line-height:1.1}
.appbar-cta .lb small{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:1px}
.appbar-cta .lb b{font-size:15px;font-weight:700;color:var(--gold)}
.appbar-cta .x{background:none;border:none;color:var(--muted);cursor:pointer;font-size:18px;padding:4px 8px;margin-left:auto}
</style>
</head>
