{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh tools/seo-agent/hooks/run.sh pre_bash" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "sh tools/seo-agent/hooks/run.sh post_write" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh tools/seo-agent/hooks/run.sh on_stop" }
        ]
      }
    ]
  }
}
